{
  "name": "express-smart-throttle",
  "version": "0.1.0",
  "description": "Smart, flexible, and role-based rate-limiting middleware for Express.js",
  "main": "dist/middleware/smartThrottle.js",
  "types": "dist/middleware/smartThrottle.d.ts",
  "exports": {
    ".": {
      "import": "./dist/middleware/smartThrottle.js",
      "require": "./dist/middleware/smartThrottle.js"
    }
  },
  "scripts": {
    "dev": "ts-node example/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ganshul34/express-smart-throttle.git"
  },
  "keywords": [
    "express",
    "rate-limiter",
    "middleware",
    "throttle",
    "role-based",
    "rate-limiting"
  ],
  "author": "Anshul Gupta",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "eslint": "^8.56.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "express": "^4.18.4"
  }
}
